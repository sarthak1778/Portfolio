# GitHub Integration
# Optional personal access token (classic or fine-grained) to increase GitHub API rate limits from 60 to 5,000 requests/hr.
# Never expose this to the browser!
GITHUB_TOKEN=

# LinkedIn Integration
# Optional LinkedIn OAuth 2.0 User Access Token with r_liteprofile / r_member_social scope for live post synchronization.
# If not provided, the portfolio seamlessly uses the verified, manually approved JSON fallback feed (data/linkedin-activity.json).
LINKEDIN_ACCESS_TOKEN=

# Local Development Port
PORT=3000
